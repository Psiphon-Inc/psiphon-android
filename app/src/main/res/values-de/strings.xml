  <!--First sentence of the notifications permission rationale message. The format qualifier %s will be replaced by the app name, either 'Psiphon' or 'Psiphon Pro' and should be placed according to the rules of the translation language.-->
  <string name="notifications_permission_rationale_intro">%s verwendet Benachrichtigungen, um Ihnen wichtige Informationen bereitzustellen, wenn die App im Hintergrund läuft. Dazu gehören:</string>
  <!--Notifications permission rationale list item-->
  <string name="notifications_permission_rationale_vpn_state_bp">Änderungen an Ihrem VPN-Verbindungsstatus.</string>
  <!--Notifications permission rationale list item-->
  <string name="notifications_permission_rationale_connection_problems_bp">Probleme mit Ihrer Verbindung.</string>
  <!--Notifications permission rationale list item-->
  <string name="notifications_permission_rationale_crash_reports_bp">Absturzberichte.</string>
  <!--Notifications permission rationale list item, do not translate or transliterate "MalAware"-->
