  <!--Title of the toolbar notification which is shown to the user when Psiphon server detects an unsafe Internet traffic-->
  <string name="unsafe_traffic_alert_notification_title">Psiphon-Malware</string>
  <!--Content of the toolbar notification which is shown to the user when Psiphon server detects an unsafe Internet traffic-->
  <string name="unsafe_traffic_alert_notification_message">Malware-Verkehr erkannt! Klicken Sie hier, um mehr zu erfahren.</string>
  <!--Title of the alert dialog which is shown to the user when they click toolbar notification of unsafe Internet traffic-->
  <string name="unsafe_traffic_alert_dialog_title">Psiphon-Malware</string>
  <!--Content of the alert dialog which is shown to the user when they click toolbar notification of unsafe Internet traffic-->
  <string name="unsafe_traffic_alert_dialog_message">Psiphon hat den Zugriff auf potenziell bösartige Websites im Internet erkannt und blockiert. Weitere Informationen finden Sie unter den folgenden Links.\n\nErkannte Malware:</string>
  <!--Title of the alert dialog which prompts the user to enable or disable unsafe Internet traffic alerts-->
  <string name="unsafe_traffic_alert_prompt_title">Psiphon-Malware</string>
  <!--Content of the alert dialog which prompts the user to enable or disable unsafe Internet traffic alerts-->
  <string name="unsafe_traffic_alert_prompt_message">Psiphon blockiert automatisch den Zugriff auf potenziell schädliche Websites im Internet. Möchten Sie benachrichtigt werden, wenn dies geschieht?\n\nDiese Einstellung kann später unter Weitere Optionen geändert werden.</string>
  <!--More info with a URL link in the contents of the alert dialog which prompts the user to enable or disable unsafe Internet traffic alerts-->
  <string name="unsafe_traffic_alert_prompt_message_more_info">Erfahren Sie mehr über MalAware hier :</string>
  <!--"Upstream proxy error" notification title-->
  <string name="notification_title_upstream_proxy_error">Upstream-Proxy-Fehler</string>
  <!--"Upstream proxy error" notification text-->
  <string name="notification_text_upstream_proxy_error">Bitte öffnen Sie Psiphon und überprüfen Sie die Proxy-Einstellungen.</string>
  <!--"Upstream proxy error" alert dialog title-->
  <string name="upstream_proxy_error_alert_title">Proxy-Fehler</string>
  <!--"Upstream proxy error" alert dialog message-->
  <string name="upstream_proxy_error_alert_message">Sie haben Psiphon so konfiguriert, dass es einen Upstream-Proxy verwendet. Allerdings können wir über diesen Proxy anscheinend keine Verbindung zu einem Psiphon-Server herstellen.\n\nBitte korrigieren Sie die Einstellungen und versuchen Sie es erneut.\n\nTechnische Informationen finden Sie in den Protokollen.</string>
  <!--Notification title for the 'Psiphon crash detected' notification-->
  <string name="psiphon_native_crash_notification_title">Psiphon ist früher abgestürzt</string>
  <!--Notification short message for the 'Psiphon crash detected' notification-->
  <string name="psiphon_native_crash_notification_msg">Bitte senden Sie uns eine Rückmeldung.</string>
  <!--Notification longer message for the 'Psiphon crash detected' notification-->
  <string name="psiphon_native_crash_notification_msg_long">Klicken Sie bitte auf diese Benachrichtigung, um uns eine Rückmeldung zu senden. Dadurch können wir das Problem besser verstehen und schneller beheben.</string>
  <!--Data collection disclosure prompt button text-->
  <string name="vpn_data_collection_disclosure_accept_btn_text">Ich akzeptiere</string>
  <!--Data collection disclosure prompt title-->
  <string name="vpn_data_collection_disclosure_prompt_title">Offenlegung der Datenerfassung</string>
  <!--First sentence of the data collection disclosure prompt body. The format qualifier %s will be replaced by the app name, either 'Psiphon' or 'Psiphon Pro' and should be placed according to the rules of the translation language.-->
  <string name="vpn_data_collection_disclosure_top">1%s verwendet den Android VPN-Dienst, um Ihnen unzensierten Zugriff auf Internetinhalte zu ermöglichen. Wir sammeln, aggregieren und speichern die folgenden Informationen:</string>
  <!--Data collection disclosure list item-->
  <string name="vpn_data_collection_disclosure_bp1">Ihre Stadt, Ihr Land, Ihr ISP und optional Ihren ungefähreren Standort. Stadt, Land und ISP werden von der IP-Adresse abgeleitet, von der aus Sie sich mit unseren Servern verbinden, und die IP-Adresse selbst wird nie protokolliert. Diese Daten werden für Nutzungs- und Leistungsstatistiken sowie zur Serviceintegrität gesammelt.</string>
  <!--Data collection disclosure list item-->
  <string name="vpn_data_collection_disclosure_bp2">Ihre E-Mail-Adresse, wenn Sie uns eine Diagnose oder eine Rückmeldung eines Absturzprotokolls senden. Die Angabe einer E-Mail-Adresse in der Rückmeldung ist optional.</string>
  <!--Data collection disclosure list item-->
  <string name="vpn_data_collection_disclosure_bp3">Ihren Benutzernamen, Passwort und optional Ihre E-Mail-Adresse für Ihr PsiCash-Konto.</string>
