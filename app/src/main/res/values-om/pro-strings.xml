    <string name="rate_limit_text_subscribe_button">Amma fooyyessi!</string>

    <!-- Alert error message informing user that an unexpected error has occurred and encouraging the user to send feedback diagnostics. -->
    <string name="unexpected_error_occured_send_feedback_message">Dogoggorri hin eegamne uumame, maaloo yaada ergii.</string>

    <!-- Auto dismissable alert message informing users that subscription options are not available at the moment -->
    <string name="subscription_options_currently_not_available">Filannoowwan miseensummaa ammaan hin jiran, maaloo boodarra yaali.</string>

    <!-- Title of the tolbar notification which is shown to the user when Psiphon server detects an unsupported Internet traffic request  -->
    <string name="disallowed_traffic_alert_notification_title">Psiphon Pro fooyyessi</string>

    <!-- Content of the toolbar notification which is shown to the user when Psiphon server detects an unsupported Internet traffic request  -->
    <string name="disallowed_traffic_alert_notification_message">Applikeeshiniiwwan hin hojjatanii? Muuxannoo kee Psiphon fooyyessuuf asitti cuqaasi!</string>

    <!-- Content of the alert dialog which is shown to the user when they click toolbar notification of unsupported Internet traffic request  -->
    <string name="disallowed_traffic_alert_dialog_message">Tiraafikii interneetii muraasa Psiphon Pro version bilisaa dhaan hin deeggarmani. Muuxannoo Psiphon keessan humna guutuu isaanii hiikuuf miseensummaa bitadhaa.</string>

    <!-- Text on the button which takes user to subscription screen -->
    <string name="btn_get_subscription">Miseensa taahi</string>

    <!-- Header text appearing on the subscriptions screen when the user has a limited subscription plan. Note the use of a non-breaking space in '5 Mb/s' -->
    <string name="PaymentChooserActivity.UsingLimitedPlan">Karoora bu\'uuraa saffisi isaa 5&#160;Mb/s tti daangeffame fayyadamaa jirta. Gara karoora daangaa hin qabneetti fooyyessuun barbaaddaa?</string>

    <!-- Header text appearing on the subscriptions screen when the user doesn't have a subscription. -->
    <string name="PaymentChooserActivity.UsingFreePlan">Karoora bilisaa, beeksisa deeggaran, saffisa daangeffame, buufata daangeffame fayyadamaa jirta. Karoora kana itti fayyadamuu dandeessa ykn karoora premium keenya keessaa tokkotti fooyyessuu dandeessa</string>

    <!-- Alternative header text appearing on the subscriptions screen when the user doesn't have a subscription. -->
    <string name="PaymentChooserActivity.PsiphonNotFreeRegion">Psiphon naanno keessan keessatti deebi\'ee bilisa miti. Tajaajila kana itti fayyadamuu keetif karoora premium keenya keessaa tokko olii fudhadhu</string>

    <!-- Common description text for all time passes. A time pass is a single use license that is valid for a certain
    period of time from the moment it is purchased and does not automatically renew after its expiry, unlike a subscription -->
    <string name="PaymentChooserActivity.TimepassCommonDescription">Addaan kutinsa hin qabne, saffisa daangaa hin qabne kan buufatoota daangaa hin qabne qabu yeroo darbuun tokkoon tokkoon bittee</string>

    <!-- Label for button that user will click to buy a 7-day pass for Psiphon Pro.
